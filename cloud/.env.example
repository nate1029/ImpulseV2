# Copy to .env for local development (npm run dev). On Cloud Run pass them with
# --set-env-vars / --set-secrets, on Vercel in Project Settings > Environment
# Variables. Never commit real values.

# Where to listen. The defaults suit a laptop (localhost only); a container
# needs every interface, and Cloud Run sets PORT itself (the Dockerfile sets both).
# HOST=0.0.0.0
# PORT=8080

# Postgres (Neon: use the pooled connection string, with sslmode=require).
DATABASE_URL=postgres://impulse@127.0.0.1:55432/impulse_dev

# 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL of this server (OAuth redirects and sign-in links use it).
IMPULSE_CLOUD_URL=http://localhost:8787

# Impulse's own keys: every user's AI requests are paid from them. Each model
# names its vendor; a vendor without a key here is simply not offered.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google: OAuth client of type "Web application".
# Authorized redirect URI: <IMPULSE_CLOUD_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: OAuth App. Authorization callback URL: <IMPULSE_CLOUD_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email codes (sign-in, verification). Tried in this order: SMTP, Brevo, Resend;
# without any, codes are printed to the server log (development only).
#
# SMTP (recommended with no domain): mail is sent through the provider's own
# authenticated servers, so it lands in the inbox, not spam. Easiest is Gmail
# with an App Password (Google account → 2-Step Verification → App passwords;
# needs 2FA on). Set EMAIL_FROM to that same Gmail address. ~500 mails/day.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or any SMTP server as a URL (wins over GMAIL_*): smtps://user:pass@host:465
SMTP_URL=
# Brevo: free, no domain — verify one sender email in the Brevo dashboard.
BREVO_API_KEY=
# Resend: needs a verified sending domain.
RESEND_API_KEY=
# SMTP/Gmail: the sending Gmail address. Brevo: a verified sender. Resend: on a
# verified domain.
EMAIL_FROM=Impulse <hello@your-domain.com>

# Comma-separated addresses that become admins once verified.
ADMIN_EMAILS=you@example.com

# Where "/" redirects (the marketing site).
IMPULSE_WEBSITE_URL=https://impulse-ide.vercel.app
